--------------------
-- GESTURES
--------------------

-- workspace_swipe itself was removed from the config options.
-- The current gesture API explicitly defines the gesture.
--
-- This corresponds to the old default 3-finger workspace swipe.
hl.gesture({
    fingers = 3,
    direction = "horizontal",
    action = "workspace",
})


--------------------
-- KEYBINDS
--------------------

local mainMod = "SUPER"


-- Utility programs
hl.bind(
    mainMod .. " + A",
    hl.dsp.exec_cmd("~/.config/scripts/set-audio-sink")
)

hl.bind(
    mainMod .. " + B",
    hl.dsp.exec_cmd("~/.config/scripts/connect_bluetooth_device")
)


-- Application launcher.
--
-- Your old config focused Rofi after 200ms and then again after another
-- 200ms. Do the same using Lua rather than calling old-style
-- `hyprctl dispatch focuswindow`.
local function focusRofi()
    hl.dispatch(
        hl.dsp.focus({
            window = "class:^(Rofi)$",
        })
    )
end

hl.bind(mainMod .. " + D", function()
    hl.exec_cmd("rofi -show drun")

    hl.timer(focusRofi, {
        timeout = 200,
        type = "oneshot",
    })

    hl.timer(focusRofi, {
        timeout = 400,
        type = "oneshot",
    })
end)


-- General
hl.bind(
    mainMod .. " + X",
    hl.dsp.exec_cmd("swaylock")
)

hl.bind(
    mainMod .. " + Q",
    hl.dsp.exec_cmd("alacritty -e zellij")
)

hl.bind(
    mainMod .. " + SHIFT + Q",
    hl.dsp.exec_cmd("alacritty")
)

hl.bind(
    mainMod .. " + C",
    hl.dsp.window.close()
)

hl.bind(
    mainMod .. " + SHIFT + P",
    hl.dsp.exit()
)

hl.bind(
    mainMod .. " + E",
    hl.dsp.exec_cmd("dolphin")
)

hl.bind(
    mainMod .. " + V",
    hl.dsp.window.float({
        action = "toggle",
    })
)

hl.bind(
    mainMod .. " + R",
    hl.dsp.exec_cmd("wofi --show run")
)


-- Old:
--   fullscreen, 1 -> maximize
--   fullscreen, 0 -> true fullscreen
hl.bind(
    mainMod .. " + F",
    hl.dsp.window.fullscreen({
        mode = "maximized",
    })
)

hl.bind(
    mainMod .. " + SHIFT + F",
    hl.dsp.window.fullscreen({
        mode = "fullscreen",
    })
)


--------------------
-- WINDOW RULES
--------------------

hl.window_rule({
    name = "noborder-fullscreen",

    match = {
        fullscreen = true,
    },

    decorate = false,
})


--------------------
-- WINDOW FOCUS / MOVEMENT
--------------------

-- Move focus
hl.bind(
    mainMod .. " + left",
    hl.dsp.focus({ direction = "l" })
)

hl.bind(
    mainMod .. " + right",
    hl.dsp.focus({ direction = "r" })
)

hl.bind(
    mainMod .. " + up",
    hl.dsp.focus({ direction = "u" })
)

hl.bind(
    mainMod .. " + down",
    hl.dsp.focus({ direction = "d" })
)


-- Move windows
hl.bind(
    mainMod .. " + SHIFT + left",
    hl.dsp.window.move({ direction = "l" })
)

hl.bind(
    mainMod .. " + SHIFT + right",
    hl.dsp.window.move({ direction = "r" })
)

hl.bind(
    mainMod .. " + SHIFT + up",
    hl.dsp.window.move({ direction = "u" })
)

hl.bind(
    mainMod .. " + SHIFT + down",
    hl.dsp.window.move({ direction = "d" })
)


--------------------
-- WORKSPACES
--------------------

-- SUPER + [1-0] switches to workspace 1-10.
--
-- SUPER + SHIFT + [1-0] moves the current window there without
-- following it, reproducing movetoworkspacesilent.
for i = 1, 10 do
    local key = tostring(i % 10)

    hl.bind(
        mainMod .. " + " .. key,
        hl.dsp.focus({
            workspace = i,
        })
    )

    hl.bind(
        mainMod .. " + SHIFT + " .. key,
        hl.dsp.window.move({
            workspace = i,
            follow = false,
        })
    )
end


-- Scroll through existing workspaces
hl.bind(
    mainMod .. " + mouse_down",
    hl.dsp.focus({
        workspace = "e+1",
    })
)

hl.bind(
    mainMod .. " + mouse_up",
    hl.dsp.focus({
        workspace = "e-1",
    })
)


--------------------
-- MOUSE
--------------------

-- SUPER + LMB: move window
hl.bind(
    mainMod .. " + mouse:272",
    hl.dsp.window.drag(),
    {
        mouse = true,
    }
)

-- SUPER + RMB: resize window
hl.bind(
    mainMod .. " + mouse:273",
    hl.dsp.window.resize(),
    {
        mouse = true,
    }
)


--------------------
-- MEDIA
--------------------

-- bindl -> locked = true
-- bindle -> locked = true, repeating = true

hl.bind(
    "XF86AudioPlay",
    hl.dsp.exec_cmd("playerctl play-pause"),
    {
        locked = true,
    }
)

hl.bind(
    "SHIFT + XF86AudioPlay",
    hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioPrev",
    hl.dsp.exec_cmd("playerctl previous"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioNext",
    hl.dsp.exec_cmd("playerctl next"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioMute",
    hl.dsp.exec_cmd("pactl set-sink-mute @DEFAULT_SINK@ toggle"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioRaiseVolume",
    hl.dsp.exec_cmd("pactl set-sink-volume @DEFAULT_SINK@ +5%"),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86AudioLowerVolume",
    hl.dsp.exec_cmd("pactl set-sink-volume @DEFAULT_SINK@ -5%"),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "SHIFT + XF86AudioRaiseVolume",
    hl.dsp.exec_cmd("playerctl next"),
    {
        locked = true,
    }
)

hl.bind(
    "SHIFT + XF86AudioLowerVolume",
    hl.dsp.exec_cmd("playerctl previous"),
    {
        locked = true,
    }
)


