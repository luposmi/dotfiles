--
-- Hyprland configuration
-- chezmoi template
--

--------------------
-- AUTOSTART
--------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("mako")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("waybar")
    hl.exec_cmd("/home/main/bin/awatcher")
    hl.exec_cmd("element-desktop --hidden")
end)


--------------------
-- MONITORS
--------------------

{{- if eq .chezmoi.hostname "mainpc" }}

-- Display config: main PC
hl.monitor({
    output = "DP-3",
    mode = "2560x1440@180",
    position = "0x0",
    scale = 1,
})

hl.monitor({
    output = "DP-2",
    mode = "1920x1080@60",
    position = "2560x0",
    scale = 1,
    transform = 0,
})

-- Workspaces 1-5 on DP-3
for i = 1, 5 do
    hl.workspace_rule({
        workspace = tostring(i),
        persistent = true,
        monitor = "DP-3",
    })
end

-- Workspaces 6-10 on DP-2
for i = 6, 10 do
    hl.workspace_rule({
        workspace = tostring(i),
        persistent = true,
        monitor = "DP-2",
    })
end

{{- end }}

{{- if eq .chezmoi.hostname "bogo-laptop" }}

-- Display config: main laptop
hl.monitor({
    output = "eDP-1",
    mode = "1920x1200@60",
    position = "0x0",
    scale = 1,
    bitdepth = 10,
    cm = "wide",
})

hl.monitor({
    output = "HDMI-A-1",
    mode = "1920x1080",
    position = "1920x0",
    scale = 1,
})

hl.monitor({
    output = "DP-4",
    mode = "1920x1080@60",
    position = "1920x0",
    scale = 1,
})

hl.monitor({
    output = "DP-3",
    mode = "1920x1080@60",
    position = "3840x0",
    scale = 1,
})

{{- end }}

-- Fallback for all otherwise unspecified monitors.
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = 1,
})


--------------------
-- ENVIRONMENT
--------------------

hl.env("XCURSOR_SIZE", "24")


