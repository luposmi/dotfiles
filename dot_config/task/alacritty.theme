# Use terminal ANSI slots so colors match Alacritty's customized Rose Pine palette.
# Keep the terminal background (including bogo-laptop's black background).
color=on
rule.color.merge=on
color.label=cyan
color.label.sort=bold cyan
color.header=magenta
color.footnote=blue
color.warning=bold yellow
color.error=bold red
color.debug=blue
color.alternate=
color.completed=green
color.deleted=bright black
color.active=bold green
color.recurring=magenta
color.scheduled=blue
color.until=yellow
color.blocked=bright black
color.blocking=cyan
color.project.none=
color.uda.priority.H=bold red
color.uda.priority.M=yellow
color.uda.priority.L=cyan
color.tag.next=bold green
color.tag.none=
color.tagged=
color.due=yellow
color.due.today=bold yellow
color.overdue=bold red
color.burndown.done=on green
color.burndown.pending=on red
color.burndown.started=on yellow
color.history.add=green
color.history.delete=red
color.history.done=cyan
color.summary.background=bright black
color.summary.bar=green
color.calendar.due=yellow
color.calendar.due.today=bold yellow
color.calendar.holiday=magenta
color.calendar.overdue=bold red
color.calendar.scheduled=blue
color.calendar.today=bold cyan
color.calendar.weekend=bright black
color.calendar.weeknumber=blue
color.sync.added=green
color.sync.changed=yellow
color.sync.rejected=red
color.undo.after=green
color.undo.before=red
