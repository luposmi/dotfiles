#!/bin/sh
set -eu
if ! command -v task >/dev/null 2>&1; then
    if command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed task
    else
        echo 'Install Taskwarrior 3 using your package manager, then rerun this script.' >&2
        exit 1
    fi
fi
case "$(task --version)" in
    3.*) ;;
    *) echo 'Taskwarrior 3 is required.' >&2; exit 1 ;;
esac
# Enable background synchronization only after the endpoint works.
task sync
systemctl --user daemon-reload
systemctl --user enable --now taskwarrior-sync.timer
