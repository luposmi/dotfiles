#!/usr/bin/env python3
"""Fuzzy-find pending tasks with a details preview; Enter shows task information."""
import argparse
import json
import shutil
import subprocess
import sys
import uuid


def clean(value):
    return ''.join(c if c.isprintable() else ' ' for c in str(value))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('query', nargs='?', default='')
    parser.add_argument('--uuid', action='store_true', help='print selected UUID for use in another task command')
    parser.add_argument('--filter', help='noninteractive fuzzy matching; select the first match')
    args = parser.parse_args()
    for dependency in ('task', 'fzf'):
        if not shutil.which(dependency):
            parser.exit(1, f'{dependency} is required\n')
    result = subprocess.run(['task', 'rc.hooks=off', 'rc.json.array=on', 'status:pending', 'export'], capture_output=True, text=True, check=True)
    tasks = json.loads(result.stdout)
    tasks.sort(key=lambda t: t.get('urgency', 0), reverse=True)
    rows = []
    for task in tasks:
        identity = str(uuid.UUID(task['uuid']))
        fields = [identity, task.get('id', ''), task.get('priority', '-'), task.get('project', '-'), ' '.join('+' + t for t in task.get('tags', [])), task.get('description', '')]
        rows.append('\t'.join(clean(field) for field in fields))
    if not rows:
        print('No pending tasks.', file=sys.stderr)
        return 1
    command = ['fzf', '--delimiter=\t', '--with-nth=2..', '--layout=reverse', '--border=rounded', '--height=80%', '--prompt=Tasks › ', '--header=ID · Priority · Project · Tags · Task | Enter: inspect | Esc: cancel', '--query=' + args.query, '--preview=task rc.hooks=off rc.color=on {1} information', '--preview-window=right:55%:wrap', '--bind=ctrl-/:toggle-preview']
    if args.filter is not None:
        command.append('--filter=' + args.filter)
    selected = subprocess.run(command, input='\n'.join(rows) + '\n', capture_output=True, text=True)
    if selected.returncode in (1, 130):
        return 1
    selected.check_returncode()
    identity = str(uuid.UUID(selected.stdout.splitlines()[0].split('\t')[0]))
    if args.uuid:
        print(identity)
        return 0
    return subprocess.run(['task', identity, 'information']).returncode


if __name__ == '__main__':
    sys.exit(main())
